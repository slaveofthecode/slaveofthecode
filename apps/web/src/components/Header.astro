---
import { getContent } from "@portfolio/content";
import { type Locale, localizedPath } from "../i18n";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  locale: Locale;
  path?: string;
}

const { locale, path = "/" } = Astro.props;
const { profile } = getContent(locale);
---

<header
  class="mx-auto flex w-full max-w-3xl items-center justify-between gap-4 px-5 py-6"
>
  <a
    href={localizedPath(locale, "/")}
    class="font-heading text-sm tracking-wide text-fg focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-fg"
  >
    {profile.name}
  </a>
  <div class="flex items-center gap-2">
    <LanguageSwitcher locale={locale} path={path} />
    <ThemeToggle locale={locale} />
  </div>
</header>
