---
import type { Profile } from "@portfolio/content";
import { type Locale, getStrings } from "../../i18n";
import { initials } from "../../lib/initials";
import { iconName } from "../../lib/links";
import { resumeFilename } from "../../lib/resume";
import Icon from "../Icon.astro";

interface Props {
  profile: Profile;
  locale: Locale;
}

const { profile, locale } = Astro.props;
const t = getStrings(locale);
---

<section class="py-12">
  <div class="flex flex-col items-start gap-6 sm:flex-row sm:items-center">
    {profile.avatar ? (
      <img
        src={profile.avatar}
        alt={profile.name}
        width="108"
        height="108"
        class="h-24 w-24 shrink-0 rounded-full border border-border object-cover"
      />
    ) : (
      <div
        aria-hidden="true"
        class="flex h-24 w-24 shrink-0 items-center justify-center rounded-full border border-border bg-surface font-heading text-2xl text-muted"
      >
        {initials(profile.name)}
      </div>
    )}
    <div>
      <h1 class="font-heading text-2xl leading-tight text-fg sm:text-3xl">
        {profile.name}
      </h1>
      <p class="mt-3 font-mono text-lg text-muted">{profile.headline}</p>
      <div
        class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 font-mono text-sm text-muted"
      >
        <a
          href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(profile.location)}`}
          rel="noopener"
          target="_blank"
          aria-label={`${t.cv.location}: ${profile.location}`}
          class="inline-flex items-center gap-1.5 transition-colors hover:text-fg focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-fg"
        >
          <Icon name="map-pin" class="h-4 w-4" />
          {profile.location}
        </a>
        {
          profile.email ? (
            <a
              href={`mailto:${profile.email}`}
              aria-label={`${t.cv.email}: ${profile.email}`}
              class="inline-flex items-center gap-1.5 transition-colors hover:text-fg focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-fg"
            >
              <Icon name="mail" class="h-4 w-4" />
              {profile.email}
            </a>
          ) : null
        }
        {
          profile.phone ? (
            <a
              href={`tel:${profile.phone.replace(/[^\d+]/g, "")}`}
              aria-label={`${t.cv.phone}: ${profile.phone}`}
              class="inline-flex items-center gap-1.5 transition-colors hover:text-fg focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-fg"
            >
              <Icon name="phone" class="h-4 w-4" />
              {profile.phone}
            </a>
          ) : null
        }
      </div>
      <ul class="mt-4 flex flex-wrap gap-3 font-mono text-sm" aria-label={t.cv.links}>
        {
          profile.links.map((link) => (
            <li>
              <a
                href={link.url}
                rel="me noopener"
                target="_blank"
                class="inline-flex items-center gap-2 rounded-card border border-border px-3 py-1 text-fg transition-colors hover:bg-surface focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-fg"
              >
                <Icon name={iconName(link.url)} />
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a
        href="/resume.pdf"
        download={resumeFilename(profile.name)}
        class="mt-4 inline-flex items-center gap-2 rounded-card bg-accent px-4 py-2 font-mono text-sm text-accent-fg transition-opacity hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-fg"
      >
        <Icon name="pdf" class="h-4 w-4" />
        {t.cv.download}
      </a>
    </div>
  </div>

  <p class="mt-6 max-w-prose font-mono text-base text-muted">
    {profile.summary}
  </p>
</section>
