---
import { getContent } from "@portfolio/content";
import Chat from "../components/Chat.astro";
import Section from "../components/Section.astro";
import Certifications from "../components/sections/Certifications.astro";
import Education from "../components/sections/Education.astro";
import Experience from "../components/sections/Experience.astro";
import Languages from "../components/sections/Languages.astro";
import Now from "../components/sections/Now.astro";
import Profile from "../components/sections/Profile.astro";
import Skills from "../components/sections/Skills.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { strings as t } from "../lib/strings";

const content = getContent();
---

<BaseLayout>
  <Profile profile={content.profile} />

  <Section id="experience" title={t.nav.experience}>
    <Experience items={content.experience} />
  </Section>

  <Section id="skills" title={t.nav.skills}>
    <Skills groups={content.skills} />
  </Section>

  {
    content.languages.length > 0 ? (
      <Section id="languages" title={t.nav.languages}>
        <Languages items={content.languages} />
      </Section>
    ) : null
  }

  {
    content.education.length > 0 ? (
      <Section id="education" title={t.nav.education}>
        <Education items={content.education} />
      </Section>
    ) : null
  }

  {
    content.certifications.length > 0 ? (
      <Section id="certifications" title={t.nav.certifications}>
        <Certifications items={content.certifications} />
      </Section>
    ) : null
  }

  {
    content.now.length > 0 ? (
      <Section id="now" title={t.now.heading} icon="thinking">
        <Now items={content.now} />
      </Section>
    ) : null
  }

  <Chat name={content.profile.name} avatar={content.profile.avatar} />
</BaseLayout>
