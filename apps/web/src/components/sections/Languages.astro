---
import type { Language } from "@portfolio/content";

interface Props {
  items: Language[];
}

const { items } = Astro.props;
---

<ul class="space-y-3">
  {
    items.map((language) => (
      <li class="flex flex-wrap items-baseline justify-between gap-x-4 border-b border-border pb-3 font-mono text-sm last:border-b-0 last:pb-0">
        <span class="text-fg">{language.name}</span>
        <span class="text-muted">{language.level}</span>
      </li>
    ))
  }
</ul>
