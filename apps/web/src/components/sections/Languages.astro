---
import type { Language } from "@portfolio/content";

interface Props {
  items: Language[];
}

const { items } = Astro.props;
---

<ul class="space-y-3">
  {
    items.map((language) => (
      <li class="flex flex-wrap items-baseline justify-between gap-x-4 font-mono text-sm">
        <span class="text-fg">{language.name}</span>
        <span class="text-subtle">{language.level}</span>
      </li>
    ))
  }
</ul>
