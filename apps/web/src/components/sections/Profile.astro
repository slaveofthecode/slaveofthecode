---
import type { Profile } from "@portfolio/content";
import { initials } from "../../lib/initials";
import { iconName, isSameOrigin } from "../../lib/links";
import { renderMarkdown } from "../../lib/markdown";
import { profileSummary } from "../../lib/profile-summary";
import { strings as t } from "../../lib/strings";
import Icon from "../Icon.astro";

interface Props {
  profile: Profile;
}

const { profile } = Astro.props;
const profileLinks = profile.links.filter(
  (link) => !isSameOrigin(link.url, Astro.site),
);
---

<section class="py-12">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:gap-5">
    {profile.avatar ? (
      <a
        href="/experience"
        aria-label={`${t.nav.home}: ${profile.name}`}
        class="shrink-0 rounded-full focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-fg"
      >
        <img
          src={profile.avatar}
          alt={profile.name}
          width="108"
          height="108"
          class="h-24 w-24 rounded-full border border-border object-cover"
        />
      </a>
    ) : (
      <a
        href="/experience"
        aria-label={`${t.nav.home}: ${profile.name}`}
        class="flex h-24 w-24 shrink-0 items-center justify-center rounded-full border border-border bg-surface font-heading text-2xl text-muted focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-fg"
      >
        <span aria-hidden="true">{initials(profile.name)}</span>
      </a>
    )}
    <div class="min-w-0 flex-1">
      <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-start sm:justify-between sm:gap-x-3 sm:gap-y-2">
        <a
          href="/experience"
          class="min-w-0 rounded-card focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-fg"
        >
          <h1 class="font-heading text-2xl leading-tight text-fg sm:text-3xl">
            {profile.name}
          </h1>
          <p class="mt-0 font-mono text-base text-muted sm:text-lg">
            {profile.headline}
          </p>
        </a>
        <div class="flex flex-col items-start gap-1 sm:items-end">
          <ul class="flex items-center gap-0.5" aria-label={t.cv.links}>
            {
              profileLinks.map((link) => (
                <li>
                  <a
                    href={link.url}
                    rel="me noopener"
                    target="_blank"
                    aria-label={link.label}
                    title={link.label}
                    class="inline-flex h-9 w-9 items-center justify-center rounded-card text-fg transition-colors hover:bg-hover focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-fg"
                  >
                    <Icon name={iconName(link.url)} class="h-4 w-4" />
                  </a>
                </li>
              ))
            }
          </ul>
          <div class="flex flex-col items-start gap-0.5 font-mono text-xs text-muted sm:items-end">
            {
              profile.email ? (
                <a
                  href={`mailto:${profile.email}`}
                  aria-label={`${t.cv.email}: ${profile.email}`}
                  class="inline-flex max-w-full items-center gap-1.5 break-all transition-colors hover:text-fg focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-fg"
                >
                  <Icon name="mail" class="h-3.5 w-3.5 shrink-0" />
                  {profile.email}
                </a>
              ) : null
            }
            <a
              href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(profile.location)}`}
              rel="noopener"
              target="_blank"
              aria-label={`${t.cv.location}: ${profile.location}`}
              class="inline-flex max-w-full items-center gap-1.5 break-all transition-colors hover:text-fg focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-fg"
            >
              <Icon name="map-pin" class="h-3.5 w-3.5 shrink-0" />
              {profile.location}
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="mt-8 sm:mt-12">
    <h2 class="mb-3 font-heading text-xs uppercase tracking-widest text-subtle sm:hidden">
      {t.cv.about}
    </h2>
    <div class="p-4 sm:p-0">
      <div
        class="summary-markdown font-mono text-base leading-7 text-fg sm:text-base sm:leading-relaxed sm:text-muted"
        set:html={renderMarkdown(profileSummary(profile))}
      />
    </div>
  </div>
</section>
