---
import { getContent } from "@portfolio/content";
import Chat from "../components/Chat.astro";
import Section from "../components/Section.astro";
import Certifications from "../components/sections/Certifications.astro";
import Education from "../components/sections/Education.astro";
import Experience from "../components/sections/Experience.astro";
import Languages from "../components/sections/Languages.astro";
import Now from "../components/sections/Now.astro";
import PersonalProjects from "../components/sections/PersonalProjects.astro";
import Profile from "../components/sections/Profile.astro";
import Skills from "../components/sections/Skills.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { defaultCvSectionId, hasCvSection } from "../lib/sections";
import { strings as t } from "../lib/strings";

const content = getContent();

const tabSections = [
  { id: "experience" as const, label: t.nav.experience },
  { id: "skills" as const, label: t.nav.skills },
  { id: "languages" as const, label: t.nav.languages },
  { id: "education" as const, label: t.nav.education },
  { id: "certifications" as const, label: t.nav.certifications },
  { id: "now" as const, label: t.now.heading },
  { id: "projects" as const, label: t.projects.heading },
].filter((section) => hasCvSection(content, section.id));

const defaultSection = defaultCvSectionId(content);
---

<BaseLayout>
  <Profile profile={content.profile} />

  {
    tabSections.length > 0 ? (
      <div
        role="group"
        aria-label={t.sections.label}
        data-section-tabs
        data-default-section={defaultSection}
        style="top: var(--app-header-height, 3.5rem)"
        class="sticky z-30 flex w-full gap-1 overflow-x-auto border-b border-border bg-bg"
      >
        {tabSections.map((section) => (
          <button
            type="button"
            data-section-tab
            data-section={section.id}
            aria-controls={section.id}
            aria-expanded={section.id === defaultSection}
            class="flex shrink-0 items-center justify-center gap-1 whitespace-nowrap border-b-2 border-transparent px-3 py-3 text-center font-mono text-[11px] uppercase leading-tight tracking-wide text-muted transition-colors hover:text-fg aria-expanded:border-fg aria-expanded:text-fg focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-fg sm:flex-1 sm:basis-0 sm:px-2 sm:text-xs"
          >
            <span aria-hidden="true">[</span>
            <span>{section.label}</span>
            <span aria-hidden="true">]</span>
          </button>
        ))}
      </div>
    ) : null
  }

  {
    hasCvSection(content, "experience") ? (
      <Section id="experience" title={t.nav.experience} open={defaultSection === "experience"}>
        <Experience items={content.experience} />
      </Section>
    ) : null
  }

  {
    hasCvSection(content, "skills") ? (
      <Section id="skills" title={t.nav.skills} open={defaultSection === "skills"}>
        <Skills groups={content.skills} />
      </Section>
    ) : null
  }

  {
    hasCvSection(content, "languages") ? (
      <Section id="languages" title={t.nav.languages} open={defaultSection === "languages"}>
        <Languages items={content.languages} />
      </Section>
    ) : null
  }

  {
    hasCvSection(content, "education") ? (
      <Section id="education" title={t.nav.education} open={defaultSection === "education"}>
        <Education items={content.education} />
      </Section>
    ) : null
  }

  {
    hasCvSection(content, "certifications") ? (
      <Section id="certifications" title={t.nav.certifications} open={defaultSection === "certifications"}>
        <Certifications items={content.certifications} />
      </Section>
    ) : null
  }

  {
    hasCvSection(content, "now") ? (
      <Section id="now" title={t.now.heading} open={defaultSection === "now"}>
        <Now items={content.now} />
      </Section>
    ) : null
  }

  {
    hasCvSection(content, "projects") ? (
      <Section id="projects" title={t.projects.heading} open={defaultSection === "projects"}>
        <PersonalProjects items={content.personalProjects} />
      </Section>
    ) : null
  }

  <Chat name={content.profile.name} avatar={content.profile.avatar} />
</BaseLayout>

<script>
  const tabs = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-section-tab]"),
  );
  const defaultSection =
    document.querySelector<HTMLElement>("[data-section-tabs]")?.dataset
      .defaultSection ?? "";
  const panels = new Map(
    tabs.map((tab) => [
      tab.dataset.section ?? "",
      document.getElementById(tab.dataset.section ?? ""),
    ]),
  );

  const tabBar = document.querySelector<HTMLElement>("[data-section-tabs]");

  const revealTab = (id: string) => {
    const tab = tabs.find((item) => item.dataset.section === id);
    if (!tab || !tabBar || tabBar.scrollWidth <= tabBar.clientWidth) return;
    const left =
      tab.getBoundingClientRect().left -
      tabBar.getBoundingClientRect().left +
      tabBar.scrollLeft -
      (tabBar.clientWidth - tab.offsetWidth) / 2;
    tabBar.scrollTo({ left, behavior: "smooth" });
  };

  const isSectionId = (id: string) =>
    tabs.some((tab) => tab.dataset.section === id);

  const resolveSection = (id: string) =>
    id && isSectionId(id) ? id : defaultSection;

  const setExpanded = (tab: HTMLButtonElement, expanded: boolean) => {
    tab.setAttribute("aria-expanded", String(expanded));
    const panel = panels.get(tab.dataset.section ?? "");
    if (panel) panel.toggleAttribute("hidden", !expanded);
  };

  const applySection = (id: string, focus = false) => {
    for (const tab of tabs) {
      setExpanded(tab, Boolean(id) && tab.dataset.section === id);
    }
    if (id) revealTab(id);
    if (focus && id) {
      tabs
        .find((tab) => tab.dataset.section === id)
        ?.focus({ preventScroll: true });
    }
  };

  const scrollToSection = (id: string) => {
    requestAnimationFrame(() =>
      panels.get(id)?.scrollIntoView({ behavior: "smooth", block: "start" }),
    );
  };

  const setUrl = (id: string, replace = false) => {
    const nextUrl = id ? `/${id}` : "/";
    if (`${window.location.pathname}${window.location.hash}` === nextUrl) return;
    if (replace) window.history.replaceState({ section: id }, "", nextUrl);
    else window.history.pushState({ section: id }, "", nextUrl);
  };

  const sectionFromUrl = () => {
    const pathId =
      window.location.pathname.split("/").filter(Boolean).pop() ?? "";
    const hashId = decodeURIComponent(window.location.hash.replace(/^#/, ""));
    const requested = [pathId, hashId].find(isSectionId);
    if (requested) return requested;
    return window.matchMedia("(max-width: 639px)").matches ? "" : defaultSection;
  };

  const goToSection = (id: string, focus = false, scroll = false) => {
    const target = resolveSection(id);
    setUrl(target);
    applySection(target, focus);
    if (scroll && target) scrollToSection(target);
  };

  const syncFromUrl = (scroll = false, replace = false) => {
    const id = sectionFromUrl();
    if (replace) setUrl(id, true);
    applySection(id);
    if (scroll && id) scrollToSection(id);
  };

  for (const tab of tabs) {
    tab.addEventListener("click", () => {
      const id = tab.dataset.section;
      if (id) goToSection(id);
    });
  }

  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element)) return;
    if (
      event instanceof MouseEvent &&
      (event.button !== 0 ||
        event.metaKey ||
        event.ctrlKey ||
        event.shiftKey ||
        event.altKey)
    ) {
      return;
    }
    const link = event.target.closest<HTMLAnchorElement>("a[href]");
    if (!link || link.hasAttribute("download")) return;
    if (link.target && link.target !== "_self") return;
    const url = new URL(link.href, window.location.href);
    if (url.origin !== window.location.origin) return;
    const pathId = url.pathname.split("/").filter(Boolean).pop() ?? "";
    const hashId = decodeURIComponent(url.hash.replace(/^#/, ""));
    const id = [pathId, hashId].find(isSectionId);
    if (!id) return;
    event.preventDefault();
    goToSection(id, true, true);
  });

  window.addEventListener("popstate", () => syncFromUrl(false, true));
  window.addEventListener("hashchange", () => syncFromUrl(false, true));
  syncFromUrl(false, true);
</script>
