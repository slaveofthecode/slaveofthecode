---
import { getContent } from "@portfolio/content";
import { type Locale, getStrings, localizedPath } from "../i18n";
import { initials } from "../lib/initials";
import Icon from "./Icon.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  locale: Locale;
  path?: string;
}

const { locale, path = "/" } = Astro.props;
const t = getStrings(locale);
const { profile } = getContent(locale);

const navItems = [
  { id: "experience", label: t.nav.experience },
  { id: "skills", label: t.nav.skills },
  { id: "education", label: t.nav.education },
  { id: "now", label: t.nav.now },
] as const;
---

<header
  data-header
  class="sticky top-0 z-40 border-b border-border bg-bg/80 backdrop-blur"
>
  <div
    class="mx-auto flex w-full max-w-3xl items-center justify-between gap-4 px-5 py-3"
  >
    <a
      href={localizedPath(locale, "/")}
      class="header-identity flex min-w-0 items-center gap-3 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-fg"
    >
      {
        profile.avatar ? (
          <img
            src={profile.avatar}
            alt=""
            width="36"
            height="36"
            class="h-9 w-9 shrink-0 rounded-full border border-border object-cover"
          />
        ) : (
          <span
            aria-hidden="true"
            class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-border bg-surface font-heading text-xs text-muted"
          >
            {initials(profile.name)}
          </span>
        )
      }
      <span class="min-w-0">
        <span class="block truncate font-heading text-sm text-fg">
          {profile.name}
        </span>
        <span class="block truncate font-mono text-xs text-muted">
          {profile.headline}
        </span>
      </span>
    </a>

    <div class="flex items-center gap-2 sm:gap-4">
      <nav aria-label={t.nav.label} class="hidden sm:block">
        <ul class="flex items-center gap-4 font-mono text-xs">
          {
            navItems.map((item) => (
              <li>
                <a
                  href={localizedPath(locale, `/#${item.id}`)}
                  class="text-muted underline-offset-4 transition-colors hover:text-fg hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-fg"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <div class="flex items-center gap-2">
        <LanguageSwitcher locale={locale} path={path} />
        <ThemeToggle locale={locale} />
      </div>
      <button
        type="button"
        data-menu-toggle
        aria-controls="mobile-nav"
        aria-expanded="false"
        aria-label={t.nav.menu}
        class="inline-flex h-8 w-8 items-center justify-center rounded-card border border-border text-muted transition-colors hover:text-fg focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-fg sm:hidden"
      >
        <Icon name="menu" class="h-5 w-5" />
      </button>
    </div>
  </div>

  <nav
    id="mobile-nav"
    data-menu-panel
    hidden
    aria-label={t.nav.label}
    class="border-t border-border sm:hidden"
  >
    <ul class="mx-auto flex w-full max-w-3xl flex-col px-5 py-2 font-mono text-sm">
      {
        navItems.map((item) => (
          <li>
            <a
              href={localizedPath(locale, `/#${item.id}`)}
              class="block py-2 text-muted underline-offset-4 transition-colors hover:text-fg hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-fg"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  [data-header] .header-identity {
    opacity: 0;
    transform: translateY(-0.35rem);
    pointer-events: none;
    transition:
      opacity 200ms ease,
      transform 200ms ease;
  }
  [data-header].is-scrolled .header-identity {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
  @media (prefers-reduced-motion: reduce) {
    [data-header] .header-identity {
      transition: none;
    }
  }
</style>

<script>
  const header = document.querySelector("[data-header]");
  if (header) {
    const update = () =>
      header.classList.toggle("is-scrolled", window.scrollY > 140);
    update();
    window.addEventListener("scroll", update, { passive: true });

    const toggle = header.querySelector("[data-menu-toggle]");
    const panel = header.querySelector("[data-menu-panel]");
    if (toggle && panel) {
      const setOpen = (open: boolean) => {
        toggle.setAttribute("aria-expanded", String(open));
        panel.toggleAttribute("hidden", !open);
      };
      toggle.addEventListener("click", () =>
        setOpen(panel.hasAttribute("hidden")),
      );
      panel.addEventListener("click", (event) => {
        if (event.target instanceof Element && event.target.closest("a")) {
          setOpen(false);
        }
      });
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") setOpen(false);
      });
    }
  }
</script>
