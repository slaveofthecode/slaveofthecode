---
import { type Locale, getStrings } from "../i18n";
import Icon from "./Icon.astro";

interface Props {
  locale: Locale;
  name: string;
  avatar?: string;
}

const { locale, name, avatar } = Astro.props;
const t = getStrings(locale);
const apiUrl = import.meta.env.PUBLIC_API_URL ?? "http://localhost:8787";

const clientStrings = {
  greeting: t.chat.greeting,
  roleUser: t.chat.roleUser,
  roleAssistant: t.chat.roleAssistant,
  thinking: t.chat.thinking,
  error: t.chat.error,
  rateLimited: t.chat.rateLimited,
  rateLimitedDay: t.chat.rateLimitedDay,
};
---

<div data-chat data-api={apiUrl} data-locale={locale} data-name={name} data-avatar={avatar ?? ""}>
  <section
    id="chat-panel"
    data-chat-panel
    role="dialog"
    aria-labelledby="chat-panel-title"
    class="fixed inset-x-0 bottom-0 z-50 max-h-[85svh] flex-col overflow-hidden rounded-t-card border border-border bg-chat shadow-lg sm:left-auto sm:right-4 sm:bottom-24 sm:min-h-[18rem] sm:w-[30rem] sm:min-w-[24rem] sm:max-w-[min(92vw,48rem)] sm:max-h-[min(80vh,44rem)] sm:rounded-card"
  >
    <div
      data-chat-resize
      aria-hidden="true"
      class="absolute left-0 top-0 z-10 hidden h-5 w-5 cursor-nwse-resize items-start justify-start p-0.5 text-muted sm:flex"
      style="touch-action: none;"
    >
      <svg
        viewBox="0 0 16 16"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        class="h-3 w-3"
        aria-hidden="true"
      >
        <path d="M2.5 9.5 9.5 2.5" />
        <path d="M2.5 13.5 13.5 2.5" />
      </svg>
    </div>
    <header
      class="flex items-center justify-between gap-2 border-b border-border px-4 py-3"
    >
      <h2
        id="chat-panel-title"
        class="flex items-center gap-2 font-heading text-sm uppercase tracking-widest text-muted"
      >
        <Icon name="thinking" class="h-4 w-4" />
        {t.chat.heading}
      </h2>
      <button
        type="button"
        data-chat-close
        aria-label={t.chat.close}
        title={t.chat.close}
        class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-card text-muted transition-colors hover:text-fg focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-fg"
      >
        <Icon name="close" class="h-4 w-4" />
      </button>
    </header>

    <div
      class="flex min-h-0 flex-1 flex-col gap-3 overflow-y-auto px-4 py-4"
      data-messages
      role="log"
      aria-live="polite"
      aria-label={t.chat.heading}
    >
    </div>

    <form
      class="border-t border-border px-3 pt-3 pb-[max(0.75rem,env(safe-area-inset-bottom))]"
      data-form
    >
      <label class="sr-only" for="chat-input">{t.chat.label}</label>
      <div
        class="flex items-end gap-2 rounded-card border border-border bg-bg p-2 focus-within:outline focus-within:outline-2 focus-within:outline-offset-2 focus-within:outline-accent"
      >
        <textarea
          id="chat-input"
          data-input
          rows="1"
          maxlength="2000"
          placeholder={t.chat.placeholder}
          class="max-h-40 min-h-11 w-full resize-none bg-transparent px-2 py-2.5 font-mono text-sm text-fg placeholder:text-muted focus:outline-none"
        ></textarea>
        <button
          type="submit"
          data-submit
          class="inline-flex shrink-0 items-center rounded-card bg-accent px-4 py-2.5 font-mono text-xs text-accent-fg transition-opacity hover:opacity-90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-fg disabled:opacity-50"
        >
          {t.chat.send}
        </button>
      </div>
      <p class="mt-2 font-mono text-[10px] text-muted">{t.chat.disclaimer}</p>
    </form>
  </section>

  <button
    type="button"
    data-chat-toggle
    aria-expanded="false"
    aria-controls="chat-panel"
    class="fixed bottom-6 right-4 z-50 inline-flex items-center gap-2 rounded-full border border-border bg-accent px-4 py-2.5 font-mono text-xs text-accent-fg shadow-sm transition-opacity hover:opacity-90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-fg"
  >
    <Icon name="thinking" class="h-4 w-4" />
    {t.chat.launcher}
  </button>

  <script
    type="application/json"
    data-chat-strings
    is:inline
    set:html={JSON.stringify(clientStrings)}
  ></script>
</div>

<script>
  import { initials } from "../lib/initials";
  import { renderMarkdown } from "../lib/markdown";

  const root = document.querySelector<HTMLElement>("[data-chat]");

  if (root) {
    const api = (root.dataset.api ?? "").replace(/\/$/, "");
    const locale = root.dataset.locale ?? "en";
    const name = root.dataset.name ?? "";
    const avatar = root.dataset.avatar ?? "";
    const stringsEl = root.querySelector<HTMLScriptElement>("[data-chat-strings]");
    const strings = JSON.parse(stringsEl?.textContent ?? "{}") as {
      greeting: string;
      roleUser: string;
      roleAssistant: string;
      thinking: string;
      error: string;
      rateLimited: string;
      rateLimitedDay: string;
    };

    const PERSON_SVG =
      '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="h-4 w-4"><circle cx="12" cy="8" r="3.5"/><path d="M5 20c0-3.3 3.1-6 7-6s7 2.7 7 6"/></svg>';

    const panel = root.querySelector<HTMLElement>("[data-chat-panel]")!;
    const toggle = root.querySelector<HTMLButtonElement>("[data-chat-toggle]")!;
    const closeButton = root.querySelector<HTMLButtonElement>("[data-chat-close]")!;
    const messagesEl = root.querySelector<HTMLElement>("[data-messages]")!;
    const form = root.querySelector<HTMLFormElement>("[data-form]")!;
    const input = root.querySelector<HTMLTextAreaElement>("[data-input]")!;
    const submit = root.querySelector<HTMLButtonElement>("[data-submit]")!;

    type Message = { role: "user" | "assistant"; content: string };
    const history: Message[] = [];
    const MAX_MESSAGES = 12;

    function avatarEl(role: Message["role"]): HTMLElement {
      const el = document.createElement("span");
      el.className =
        "flex h-7 w-7 shrink-0 items-center justify-center overflow-hidden rounded-full border border-border bg-surface";
      if (role === "assistant") {
        // Replies are written by Gustavo, so show his photo (or initials).
        if (avatar) {
          const img = document.createElement("img");
          img.src = avatar;
          img.alt = "";
          img.className = "h-full w-full object-cover";
          el.append(img);
        } else {
          el.classList.add("font-heading", "text-[10px]", "text-muted");
          el.textContent = initials(name) || "?";
        }
      } else {
        // The visitor asking the question: a generic person icon.
        el.classList.add("text-muted");
        el.innerHTML = PERSON_SVG;
      }
      return el;
    }

    function bubble(role: Message["role"], text: string, pending = false): HTMLElement {
      const row = document.createElement("div");
      row.className =
        role === "user"
          ? "flex flex-row-reverse items-start gap-2"
          : "flex items-start gap-2";

      const col = document.createElement("div");
      col.className =
        role === "user"
          ? "flex min-w-0 max-w-[80%] flex-col items-end"
          : "flex min-w-0 max-w-[80%] flex-col items-start";

      const label = document.createElement("p");
      label.className = "mb-0.5 font-mono text-[10px] uppercase tracking-wide text-muted";
      label.textContent =
        role === "user" ? strings.roleUser : name || strings.roleAssistant;

      const card = document.createElement("div");
      card.className = [
        "max-w-full rounded-card border border-border px-3 py-2",
        role === "user" ? "bg-accent/10" : "bg-surface",
      ].join(" ");

      const body = document.createElement("div");
      body.className = pending
        ? "whitespace-pre-wrap break-words font-mono text-sm text-fg animate-pulse"
        : role === "assistant"
          ? "chat-markdown break-words font-mono text-sm text-fg"
          : "whitespace-pre-wrap break-words font-mono text-sm text-fg";
      if (role === "assistant" && !pending) {
        body.innerHTML = renderMarkdown(text);
      } else {
        body.textContent = text;
      }

      card.append(body);
      col.append(label, card);
      row.append(avatarEl(role), col);
      return row;
    }

    function scrollToBottom() {
      messagesEl.scrollTop = messagesEl.scrollHeight;
    }

    function setBusy(busy: boolean) {
      submit.disabled = busy;
      input.disabled = busy;
    }

    function resizeInput() {
      input.style.height = "auto";
      input.style.height = `${Math.min(input.scrollHeight, 160)}px`;
    }

    function openPanel() {
      panel.classList.add("is-open");
      toggle.setAttribute("aria-expanded", "true");
      input.focus();
      scrollToBottom();
    }

    function closePanel() {
      panel.classList.remove("is-open");
      toggle.setAttribute("aria-expanded", "false");
    }

    async function ask(question: string) {
      history.push({ role: "user", content: question });
      messagesEl.append(bubble("user", question));

      const pending = bubble("assistant", strings.thinking, true);
      messagesEl.append(pending);
      scrollToBottom();
      setBusy(true);

      try {
        const response = await fetch(`${api}/chat`, {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ messages: history.slice(-MAX_MESSAGES), locale }),
        });

        if (response.status === 429) {
          const body = (await response.json().catch(() => ({}))) as {
            error?: string;
          };
          throw new Error(
            body.error === "daily_limit_reached" ? "daily_limit" : "rate_limited",
          );
        }
        if (!response.ok) throw new Error("request_failed");

        const data = (await response.json()) as { reply?: string };
        const reply = data.reply?.trim() || strings.error;
        history.push({ role: "assistant", content: reply });
        pending.replaceWith(bubble("assistant", reply));
      } catch (error) {
        const message =
          error instanceof Error && error.message === "daily_limit"
            ? strings.rateLimitedDay
            : error instanceof Error && error.message === "rate_limited"
              ? strings.rateLimited
              : strings.error;
        pending.replaceWith(bubble("assistant", message));
      } finally {
        setBusy(false);
        scrollToBottom();
        input.focus();
      }
    }

    if (strings.greeting) {
      messagesEl.append(bubble("assistant", strings.greeting));
    }

    toggle.addEventListener("click", () =>
      panel.classList.contains("is-open") ? closePanel() : openPanel(),
    );
    closeButton.addEventListener("click", closePanel);

    document.addEventListener("click", (event) => {
      if (event.target instanceof Element && event.target.closest("[data-chat-open]")) {
        openPanel();
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && panel.classList.contains("is-open")) {
        closePanel();
        toggle.focus();
      }
    });

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      const question = input.value.trim();
      if (!question) return;
      input.value = "";
      resizeInput();
      void ask(question);
    });

    input.addEventListener("input", resizeInput);

    input.addEventListener("keydown", (event) => {
      if (event.key === "Enter" && !event.shiftKey) {
        event.preventDefault();
        form.requestSubmit();
      }
    });

    // Custom resize: the native CSS handle only sits bottom-right, but the panel
    // is anchored bottom-right, so we grow it from a top-left grip instead.
    const resizeHandle = root.querySelector<HTMLElement>("[data-chat-resize]");
    if (resizeHandle) {
      const MIN_W = 384; // 24rem
      const MIN_H = 288; // 18rem
      const maxW = () => Math.min(window.innerWidth * 0.92, 768); // 48rem
      const maxH = () => Math.min(window.innerHeight * 0.8, 704); // 44rem
      let dragging = false;
      let startX = 0;
      let startY = 0;
      let startW = 0;
      let startH = 0;

      resizeHandle.addEventListener("pointerdown", (event) => {
        if (!window.matchMedia("(min-width: 640px)").matches) return;
        event.preventDefault();
        dragging = true;
        startX = event.clientX;
        startY = event.clientY;
        const rect = panel.getBoundingClientRect();
        startW = rect.width;
        startH = rect.height;
        resizeHandle.setPointerCapture(event.pointerId);
        document.body.style.userSelect = "none";
      });

      resizeHandle.addEventListener("pointermove", (event) => {
        if (!dragging) return;
        const width = Math.min(
          Math.max(startW + (startX - event.clientX), MIN_W),
          maxW(),
        );
        const height = Math.min(
          Math.max(startH + (startY - event.clientY), MIN_H),
          maxH(),
        );
        panel.style.width = `${Math.round(width)}px`;
        panel.style.height = `${Math.round(height)}px`;
      });

      const stopResize = (event: PointerEvent) => {
        if (!dragging) return;
        dragging = false;
        document.body.style.userSelect = "";
        if (resizeHandle.hasPointerCapture(event.pointerId)) {
          resizeHandle.releasePointerCapture(event.pointerId);
        }
      };
      resizeHandle.addEventListener("pointerup", stopResize);
      resizeHandle.addEventListener("pointercancel", stopResize);
    }
  }
</script>

<style is:global>
  [data-chat-panel] {
    display: none;
  }
  [data-chat-panel].is-open {
    display: flex;
  }
  [data-chat-panel].is-open ~ [data-chat-toggle] {
    display: none;
  }
  .chat-markdown > :first-child {
    margin-top: 0;
  }
  .chat-markdown > :last-child {
    margin-bottom: 0;
  }
  .chat-markdown p {
    margin: 0.4rem 0;
  }
  .chat-markdown h1,
  .chat-markdown h2,
  .chat-markdown h3 {
    font-family: var(--font-heading);
    font-weight: 600;
    margin: 0.6rem 0 0.3rem;
  }
  .chat-markdown ul {
    list-style: disc;
    margin: 0.4rem 0;
    padding-left: 1.1rem;
  }
  .chat-markdown ol {
    list-style: decimal;
    margin: 0.4rem 0;
    padding-left: 1.3rem;
  }
  .chat-markdown li {
    margin: 0.15rem 0;
  }
  .chat-markdown code {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 0.25rem;
    padding: 0 0.25rem;
  }
  .chat-markdown pre {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    margin: 0.4rem 0;
    overflow-x: auto;
    padding: 0.5rem 0.75rem;
  }
  .chat-markdown pre code {
    background: none;
    border: none;
    padding: 0;
  }
  .chat-markdown a {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
