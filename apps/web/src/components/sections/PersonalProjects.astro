---
import type { PersonalProject } from "@portfolio/content";
import { iconName } from "../../lib/links";
import { strings as t } from "../../lib/strings";
import Icon from "../Icon.astro";

interface Props {
  items: PersonalProject[];
}

const { items } = Astro.props;
---

<ul class="space-y-5">
  {
    items.map((project) => (
      <li class="grid gap-5 overflow-hidden rounded-card border border-border bg-surface p-4 transition-colors hover:border-accent sm:grid-cols-[minmax(0,14rem)_minmax(0,1fr)] lg:grid-cols-[minmax(0,18rem)_minmax(0,1fr)] sm:p-5">
        <img
          src={project.thumbnailUrl}
          alt=""
          width="480"
          height="270"
          loading="lazy"
          decoding="async"
          class="aspect-video w-full rounded-card border border-border object-cover sm:aspect-auto sm:h-full sm:min-h-44"
        />
        <div class="flex min-w-0 flex-col">
          <h3 class="font-heading text-lg text-fg">{project.name}</h3>
          <p class="mt-2 font-mono text-sm leading-relaxed text-muted">
            {project.description}
          </p>

          {project.tech.length > 0 ? (
            <ul class="mt-4 flex flex-wrap gap-2">
              {project.tech.map((tech) => (
                <li class="rounded-card bg-hover px-2 py-0.5 font-mono text-xs text-muted">
                  {tech}
                </li>
              ))}
            </ul>
          ) : null}

          <div class="mt-auto flex flex-wrap gap-x-5 gap-y-2 pt-5 font-mono text-xs">
            <a
              href={project.repoUrl}
              rel="noopener"
              target="_blank"
              class="inline-flex items-center gap-1.5 text-muted underline-offset-4 transition-colors hover:text-fg hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-fg"
            >
              <Icon name={iconName(project.repoUrl)} class="h-3.5 w-3.5" />
              {t.projects.repo}
            </a>
            <a
              href={project.productionUrl}
              rel="noopener"
              target="_blank"
              class="inline-flex items-center gap-1.5 text-muted underline-offset-4 transition-colors hover:text-fg hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-fg"
            >
              <Icon name={iconName(project.productionUrl)} class="h-3.5 w-3.5" />
              {t.projects.live}
            </a>
          </div>
        </div>
      </li>
    ))
  }
</ul>
