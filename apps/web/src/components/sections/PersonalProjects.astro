---
import type { PersonalProject } from "@portfolio/content";
import { formatLongDate } from "../../lib/dates";
import { iconName } from "../../lib/links";
import {
  sortProjectsByLastCommit,
  splitProjectPreview,
} from "../../lib/projects";
import { strings as t } from "../../lib/strings";
import Icon from "../Icon.astro";

interface Props {
  items: PersonalProject[];
}

const { items } = Astro.props;
const sortedItems = sortProjectsByLastCommit(items);
const { preview, rest } = splitProjectPreview(sortedItems);
---

<ul id="projects-list" class="space-y-5">
  {
    sortedItems.map((project, index) => {
      const isExtra = index >= preview.length;
      return (
      <li
        data-project-card
        hidden={isExtra}
        class="grid gap-5 overflow-hidden rounded-card border border-border bg-surface p-4 transition-colors hover:border-accent sm:grid-cols-[minmax(0,14rem)_minmax(0,1fr)] lg:grid-cols-[minmax(0,18rem)_minmax(0,1fr)] sm:p-5"
      >
        <div
          class="relative mx-auto aspect-4/3 w-full max-w-88 cursor-zoom-in self-start overflow-hidden rounded-card border border-border transition-transform duration-300 ease-out hover:z-10 hover:scale-105 sm:mx-0 sm:max-w-none sm:hover:scale-110 motion-reduce:transition-none motion-reduce:hover:scale-100"
        >
          <img
            src={project.thumbnailUrl}
            alt=""
            width="480"
            height="360"
            loading="lazy"
            decoding="async"
            class="h-full w-full object-contain"
          />
        </div>
        <div class="flex min-w-0 flex-col">
          <h3 class="font-heading text-lg text-fg">{project.name}</h3>
          <p class="mt-2 font-mono text-sm leading-relaxed text-muted">
            {project.description}
          </p>

          {project.tech.length > 0 ? (
            <ul class="mt-4 flex flex-wrap gap-2">
              {project.tech.map((tech) => (
                <li class="rounded-card bg-hover px-2 py-0.5 font-mono text-xs text-muted">
                  {tech}
                </li>
              ))}
            </ul>
          ) : null}

          <div
            data-project-details
            class="mt-auto flex flex-wrap gap-x-5 gap-y-2 border-t border-border pt-4 font-mono text-xs"
          >
            <a
              href={project.repoUrl}
              rel="noopener"
              target="_blank"
              class="inline-flex items-center gap-1.5 text-muted underline-offset-4 transition-colors hover:text-fg hover:underline focus-visible:outline focus-visible:outline-offset-2 focus-visible:outline-fg"
            >
              <Icon name={iconName(project.repoUrl)} class="h-3.5 w-3.5" />
              {t.projects.repo}
            </a>
            <a
              href={project.productionUrl}
              rel="noopener"
              target="_blank"
              class="inline-flex items-center gap-1.5 text-muted underline-offset-4 transition-colors hover:text-fg hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-fg"
            >
              <Icon name={iconName(project.productionUrl)} class="h-3.5 w-3.5" />
              {t.projects.live}
            </a>
            <span class="ml-auto inline-flex items-center gap-1.5 whitespace-nowrap">
              <span class="text-subtle">{t.projects.lastCommit}</span>
              <time datetime={project.lastCommit} class="font-bold text-fg">
                {formatLongDate(project.lastCommit)}
              </time>
            </span>
          </div>
        </div>
      </li>
      );
    })
  }
</ul>

{
  rest.length > 0 ? (
    <div class="mt-5 flex justify-center">
      <button
        type="button"
        data-projects-toggle
        aria-controls="projects-list"
        aria-expanded="false"
        class="group inline-flex items-center gap-2 rounded-card border border-border bg-surface px-4 py-2 font-mono text-xs uppercase tracking-wide text-muted transition-colors hover:bg-hover hover:text-fg focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-fg aria-expanded:text-fg"
      >
        <span class="group-aria-expanded:hidden">{t.projects.seeMore}</span>
        <span class="hidden group-aria-expanded:inline">{t.projects.showLess}</span>
        <svg
          class="h-3.5 w-3.5 transition-transform duration-200 group-aria-expanded:rotate-180"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="m6 9 6 6 6-6" />
        </svg>
      </button>
    </div>
  ) : null
}

<script>
  import {
    PROJECTS_PREVIEW_LIMIT,
    nextVisibleProjectCount,
  } from "../../lib/projects";

  const toggle = document.querySelector<HTMLButtonElement>("[data-projects-toggle]");
  const cards = Array.from(
    document.querySelectorAll<HTMLElement>("[data-project-card]"),
  );

  if (toggle) {
    let visibleCount = Math.min(PROJECTS_PREVIEW_LIMIT, cards.length);

    toggle.addEventListener("click", () => {
      const wasFullyExpanded = visibleCount >= cards.length;
      visibleCount = nextVisibleProjectCount(visibleCount, cards.length);
      cards.forEach((card, index) => {
        card.hidden = index >= visibleCount;
      });
      toggle.setAttribute("aria-expanded", String(visibleCount >= cards.length));

      if (wasFullyExpanded) {
        const reducedMotion = window.matchMedia(
          "(prefers-reduced-motion: reduce)",
        ).matches;
        document.getElementById("projects")?.scrollIntoView({
          behavior: reducedMotion ? "auto" : "smooth",
          block: "start",
        });
      }
    });
  }
</script>
