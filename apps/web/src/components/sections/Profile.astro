---
import type { Profile } from "@portfolio/content";
import { initials } from "../../lib/initials";
import { iconName } from "../../lib/links";
import { resumeFilename } from "../../lib/resume";
import { strings as t } from "../../lib/strings";
import Icon from "../Icon.astro";

interface Props {
  profile: Profile;
}

const { profile } = Astro.props;
---

<section class="py-12">
  <div class="flex items-start gap-5">
    {profile.avatar ? (
      <img
        src={profile.avatar}
        alt={profile.name}
        width="108"
        height="108"
        class="h-24 w-24 shrink-0 rounded-full border border-border object-cover"
      />
    ) : (
      <div
        aria-hidden="true"
        class="flex h-24 w-24 shrink-0 items-center justify-center rounded-full border border-border bg-surface font-heading text-2xl text-muted"
      >
        {initials(profile.name)}
      </div>
    )}
    <div class="min-w-0 flex-1">
      <div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-1">
        <h1 class="font-heading text-2xl leading-tight text-fg sm:text-3xl">
          {profile.name}
        </h1>
        <ul class="flex items-center gap-2" aria-label={t.cv.links}>
          {
            profile.links.map((link) => (
              <li>
                <a
                  href={link.url}
                  rel="me noopener"
                  target="_blank"
                  aria-label={link.label}
                  title={link.label}
                  class="inline-flex h-9 w-9 items-center justify-center rounded-card text-fg transition-colors hover:bg-hover focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-fg"
                >
                  <Icon name={iconName(link.url)} class="h-4 w-4" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <p class="mt-1 font-mono text-base text-muted sm:text-lg">
        {profile.headline}
      </p>

      <div class="mt-2 flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
        <div class="flex min-w-0 flex-wrap items-center gap-x-4 gap-y-1 font-mono text-sm text-muted">
          {
            profile.email ? (
              <a
                href={`mailto:${profile.email}`}
                aria-label={`${t.cv.email}: ${profile.email}`}
                class="inline-flex items-center gap-1.5 transition-colors hover:text-fg focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-fg"
              >
                <Icon name="mail" class="h-4 w-4" />
                {profile.email}
              </a>
            ) : null
          }
          <a
            href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(profile.location)}`}
            rel="noopener"
            target="_blank"
            aria-label={`${t.cv.location}: ${profile.location}`}
            class="inline-flex items-center gap-1.5 transition-colors hover:text-fg focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-fg"
          >
            <Icon name="map-pin" class="h-4 w-4" />
            {profile.location}
          </a>
          {
            profile.phone ? (
              <a
                href={`tel:${profile.phone.replace(/[^\d+]/g, "")}`}
                aria-label={`${t.cv.phone}: ${profile.phone}`}
                class="inline-flex items-center gap-1.5 transition-colors hover:text-fg focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-fg"
              >
                <Icon name="phone" class="h-4 w-4" />
                {profile.phone}
              </a>
            ) : null
          }
        </div>
        <div class="flex flex-wrap items-center justify-end gap-3">
          <a
            href="/cv.pdf"
            download={resumeFilename(profile.name)}
            aria-label={`${profile.name} CV`}
            class="inline-flex items-center gap-2 rounded-card border border-border bg-surface px-3 py-1.5 font-mono text-sm text-fg transition-colors hover:bg-hover focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-fg"
          >
            <Icon name="download" class="h-4 w-4" />
            {t.cv.download}
          </a>
          <a
            href="/cv-ats.pdf"
            download={resumeFilename(profile.name, "ats")}
            aria-label={`${profile.name} ATS CV`}
            class="inline-flex items-center gap-2 rounded-card border border-border px-3 py-1.5 font-mono text-sm text-muted transition-colors hover:bg-hover hover:text-fg focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-fg"
          >
            <Icon name="download" class="h-4 w-4" />
            {t.cv.downloadAts}
          </a>
        </div>
      </div>
    </div>
  </div>

  <p class="mt-6 font-mono text-base text-muted">
    {profile.summary}
  </p>
</section>
