---
import { getContent } from "@portfolio/content";
import { type Locale, getStrings, localizedPath } from "../i18n";
import { initials } from "../lib/initials";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  locale: Locale;
  path?: string;
}

const { locale, path = "/" } = Astro.props;
const t = getStrings(locale);
const { profile } = getContent(locale);

const navItems = [
  { id: "experience", label: t.nav.experience },
  { id: "skills", label: t.nav.skills },
  { id: "education", label: t.nav.education },
  { id: "now", label: t.nav.now },
] as const;
---

<header
  data-header
  class="sticky top-0 z-40 border-b border-border bg-bg/80 backdrop-blur"
>
  <div
    class="mx-auto flex w-full max-w-3xl items-center justify-between gap-4 px-5 py-3"
  >
    <a
      href={localizedPath(locale, "/")}
      class="header-identity flex min-w-0 items-center gap-3 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-fg"
    >
      {
        profile.avatar ? (
          <img
            src={profile.avatar}
            alt=""
            width="36"
            height="36"
            class="h-9 w-9 shrink-0 rounded-full border border-border object-cover"
          />
        ) : (
          <span
            aria-hidden="true"
            class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-border bg-surface font-heading text-xs text-muted"
          >
            {initials(profile.name)}
          </span>
        )
      }
      <span class="min-w-0">
        <span class="block truncate font-heading text-sm text-fg">
          {profile.name}
        </span>
        <span class="block truncate font-mono text-xs text-muted">
          {profile.headline}
        </span>
      </span>
    </a>

    <div class="flex items-center gap-4">
      <nav aria-label={t.nav.label} class="hidden sm:block">
        <ul class="flex items-center gap-4 font-mono text-xs">
          {
            navItems.map((item) => (
              <li>
                <a
                  href={localizedPath(locale, `/#${item.id}`)}
                  class="text-muted underline-offset-4 transition-colors hover:text-fg hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-fg"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <div class="flex items-center gap-2">
        <LanguageSwitcher locale={locale} path={path} />
        <ThemeToggle locale={locale} />
      </div>
    </div>
  </div>
</header>

<style>
  [data-header] .header-identity {
    opacity: 0;
    transform: translateY(-0.35rem);
    pointer-events: none;
    transition:
      opacity 200ms ease,
      transform 200ms ease;
  }
  [data-header].is-scrolled .header-identity {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
  @media (prefers-reduced-motion: reduce) {
    [data-header] .header-identity {
      transition: none;
    }
  }
</style>

<script>
  const header = document.querySelector("[data-header]");
  if (header) {
    const update = () =>
      header.classList.toggle("is-scrolled", window.scrollY > 140);
    update();
    window.addEventListener("scroll", update, { passive: true });
  }
</script>
