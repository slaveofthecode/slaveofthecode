---
import type { SkillGroup } from "@portfolio/content";

interface Props {
  groups: SkillGroup[];
}

const { groups } = Astro.props;
---

<div class="space-y-4">
  {
    groups.map((group) => (
      <div class="-mx-3 rounded-card px-3 py-3 transition-colors hover:bg-hover">
        <h3 class="font-mono text-sm text-fg">{group.name}</h3>
        <ul class="mt-2 flex flex-wrap gap-2">
          {group.items.map((item) => (
            <li class="rounded-card border border-border bg-surface px-2 py-1 font-mono text-xs text-muted">
              {item}
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</div>
