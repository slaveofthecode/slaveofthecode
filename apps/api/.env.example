# Copy to apps/api/.env for local development. Never commit real secrets.

# Google Gemini (https://aistudio.google.com/apikey) — used for chat + embeddings.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_EMBED_MODEL=gemini-embedding-001

# Comma-separated browser origins allowed to call the API (CORS).
ALLOWED_ORIGINS=https://slaveofthecode.vercel.app,http://localhost:4321

# Chat cost caps (see docs/architecture.md → "Chat cost caps").
# Per IP: max requests per window. Global: max chat messages per UTC day
# (checked before every Gemini call → 429 + no spend when exceeded).
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_DAILY_MAX=200

# Local dev server port.
PORT=8787
