---
import { getContent } from "@portfolio/content";
import { initials } from "../lib/initials";
import { iconName } from "../lib/links";
import { resumeFilename } from "../lib/resume";
import { visibleCvSectionIds } from "../lib/sections";
import { strings as t } from "../lib/strings";
import Icon from "./Icon.astro";
import ThemeToggle from "./ThemeToggle.astro";

const content = getContent();
const { profile } = content;

const navLabels = {
  experience: t.nav.experience,
  skills: t.nav.skills,
  education: t.nav.education,
  now: t.nav.now,
  projects: t.nav.projects,
} as const;

const navItems = [
  ...visibleCvSectionIds(content)
    .filter((id): id is keyof typeof navLabels => id in navLabels)
    .map((id) => ({ id, label: navLabels[id] })),
  { id: "chat", label: t.nav.chat },
];
---

<header
  data-header
  class="sticky top-0 z-40 border-b border-border bg-header/80 backdrop-blur"
>
  <div
    class="mx-auto flex w-full max-w-[1104px] items-center justify-between gap-4 px-5 py-3 sm:px-8"
  >
    <a
      href="/experience"
      aria-label={`${t.nav.home}: ${profile.name}`}
      class="header-identity flex min-w-0 items-center gap-3 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-fg"
    >
      {
        profile.avatar ? (
          <img
            src={profile.avatar}
            alt=""
            width="36"
            height="36"
            class="h-9 w-9 shrink-0 rounded-full border border-border object-cover"
          />
        ) : (
          <span
            aria-hidden="true"
            class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-border bg-surface font-heading text-xs text-muted"
          >
            {initials(profile.name)}
          </span>
        )
      }
      <span class="min-w-0">
        <span class="block truncate font-heading text-sm text-fg">
          {profile.name}
        </span>
        <span class="block truncate font-mono text-xs text-muted">
          {profile.headline}
        </span>
        <span data-sticky-facts class="mt-1 flex flex-wrap items-center gap-1">
          <span
            title={`${t.cv.ofExperience}: ${profile.yearsOfExperience}`}
            class="rounded-card border border-border bg-surface px-1.5 py-0.5 font-mono text-[10px] text-fg"
          >
            {profile.yearsOfExperience}
          </span>
          <span
            title={`${t.cv.englishLevel}: ${profile.englishLevel}`}
            class="rounded-card border border-border bg-surface px-1.5 py-0.5 font-mono text-[10px] text-fg"
          >
            {profile.englishLevel}
          </span>
        </span>
      </span>
    </a>

    <div class="flex items-center gap-2 sm:gap-3">
      <div data-sticky-actions class="hidden items-center gap-3">
        <ul class="flex items-center gap-px" aria-label={t.cv.links}>
          {
            profile.links.map((link) => (
              <li>
                <a
                  href={link.url}
                  rel="me noopener"
                  target="_blank"
                  aria-label={link.label}
                  title={link.label}
                  class="inline-flex h-8 w-8 items-center justify-center rounded-card text-muted transition-colors hover:text-fg focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-fg"
                >
                  <Icon name={iconName(link.url)} class="h-4 w-4" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="hidden items-center gap-2 sm:mr-3 sm:flex">
        <a
          href="/cv.pdf"
          download={resumeFilename(profile.name)}
          aria-label={`${profile.name} CV`}
          class="inline-flex items-center gap-1.5 rounded-card border border-border px-2.5 py-1 font-mono text-xs text-fg transition-colors hover:bg-hover focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-fg"
        >
          <Icon name="download" class="h-3.5 w-3.5" />
          {t.cv.download}
        </a>
        <a
          href="/cv-ats.pdf"
          download={resumeFilename(profile.name, "ats")}
          aria-label={`${profile.name} ATS CV`}
          class="inline-flex items-center gap-1.5 rounded-card border border-border px-2.5 py-1 font-mono text-xs text-muted transition-colors hover:bg-hover hover:text-fg focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-fg"
        >
          <Icon name="download" class="h-3.5 w-3.5" />
          {t.cv.downloadAts}
        </a>
      </div>
      <button
        type="button"
        data-chat-open
        aria-label={t.nav.chat}
        title={t.nav.chat}
        class="hidden h-8 w-8 items-center justify-center rounded-card border border-border text-muted transition-colors hover:bg-hover hover:text-fg focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-fg sm:inline-flex"
      >
        <Icon name="chat" class="h-4 w-4" />
      </button>
      <ThemeToggle />
      <button
        type="button"
        data-menu-toggle
        aria-controls="mobile-nav"
        aria-expanded="false"
        aria-label={t.nav.menu}
        class="inline-flex h-8 w-8 items-center justify-center rounded-card border border-border text-muted transition-colors hover:text-fg focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-fg sm:hidden"
      >
        <Icon name="menu" class="h-5 w-5" />
      </button>
    </div>
  </div>

  <nav
    id="mobile-nav"
    data-menu-panel
    hidden
    aria-label={t.nav.label}
    class="border-t border-border sm:hidden"
  >
    <ul class="mx-auto flex w-full max-w-[1104px] flex-col px-5 py-2 font-mono text-sm sm:px-8">
      {
        navItems.map((item) => (
          <li>
            {item.id === "chat" ? (
              <button
                type="button"
                data-chat-open
                class="block w-full py-2 text-left font-mono text-muted underline-offset-4 transition-colors hover:text-fg hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-fg"
              >
                {item.label}
              </button>
            ) : (
              <a
                href={`/${item.id}`}
                class="block py-2 text-muted underline-offset-4 transition-colors hover:text-fg hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-fg"
              >
                {item.label}
              </a>
            )}
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  [data-header] .header-identity {
    opacity: 0;
    transform: translateY(-0.35rem);
    pointer-events: none;
    transition:
      opacity 200ms ease,
      transform 200ms ease;
  }
  [data-header].is-scrolled .header-identity {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
  @media (prefers-reduced-motion: reduce) {
    [data-header] .header-identity {
      transition: none;
    }
  }
</style>

<script>
  const header = document.querySelector("[data-header]");
  if (header) {
    const stickyActions = header.querySelector<HTMLElement>("[data-sticky-actions]");
    const laptop = window.matchMedia("(min-width: 640px)");
    const update = () => {
      const scrolled = window.scrollY > 140;
      header.classList.toggle("is-scrolled", scrolled);
      const showActions = scrolled && laptop.matches;
      stickyActions?.classList.toggle("hidden", !showActions);
      stickyActions?.classList.toggle("flex", showActions);
    };
    update();
    window.addEventListener("scroll", update, { passive: true });
    laptop.addEventListener("change", update);

    const toggle = header.querySelector("[data-menu-toggle]");
    const panel = header.querySelector("[data-menu-panel]");
    if (toggle && panel) {
      const setOpen = (open: boolean) => {
        toggle.setAttribute("aria-expanded", String(open));
        panel.toggleAttribute("hidden", !open);
      };
      toggle.addEventListener("click", () =>
        setOpen(panel.hasAttribute("hidden")),
      );
      panel.addEventListener("click", (event) => {
        if (
          event.target instanceof Element &&
          event.target.closest("a, [data-chat-open]")
        ) {
          setOpen(false);
        }
      });
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") setOpen(false);
      });
    }
  }
</script>
