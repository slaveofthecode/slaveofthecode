---
import type { Experience } from "@portfolio/content";
import { type Locale, getStrings } from "../../i18n";
import { formatRange } from "../../lib/dates";

interface Props {
  items: Experience[];
  locale: Locale;
}

const { items, locale } = Astro.props;
const t = getStrings(locale);
---

<ol class="space-y-8">
  {
    items.map((job) => (
      <li class="border-b border-border pb-6 last:border-b-0 last:pb-0">
        <article>
          <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
            <h3 class="font-heading text-base text-fg">{job.company}</h3>
            <time datetime={job.startDate} class="font-mono text-xs text-muted">
              {formatRange(job.startDate, job.endDate, locale, t.cv.present)}
            </time>
          </div>
          <p class="mt-1 font-mono text-sm text-fg">
            {job.role}
            {job.location ? ` · ${job.location}` : ""}
          </p>
          {job.summary ? (
            <p class="mt-2 max-w-prose font-mono text-sm text-muted">{job.summary}</p>
          ) : null}
          {job.highlights.length > 0 ? (
            <ul class="mt-3 list-disc space-y-1 pl-5 font-mono text-sm text-muted">
              {job.highlights.map((highlight) => (
                <li>{highlight}</li>
              ))}
            </ul>
          ) : null}
          {job.tech.length > 0 ? (
            <ul class="mt-3 flex flex-wrap gap-2">
              {job.tech.map((tech) => (
                <li class="rounded-card border border-border bg-surface px-2 py-0.5 font-mono text-xs text-muted">
                  {tech}
                </li>
              ))}
            </ul>
          ) : null}
        </article>
      </li>
    ))
  }
</ol>
