---
import type { SkillGroup } from "@portfolio/content";
import { strings as t } from "../../lib/strings";

interface Props {
  groups: SkillGroup[];
}

const { groups } = Astro.props;
---

<div class="overflow-x-auto rounded-card border border-border bg-surface">
  <table class="w-full min-w-[36rem] border-collapse font-mono text-sm">
    <thead>
      <tr class="border-b border-border text-left">
        <th
          scope="col"
          class="w-1/3 px-4 py-3 font-heading text-xs uppercase tracking-widest text-muted"
        >
          {t.skills.category}
        </th>
        <th
          scope="col"
          class="px-4 py-3 font-heading text-xs uppercase tracking-widest text-muted"
        >
          {t.skills.technologies}
        </th>
      </tr>
    </thead>
    <tbody>
      {
        groups.map((group) => (
          <tr class="border-b border-border last:border-b-0 hover:bg-hover">
            <th scope="row" class="px-4 py-3 align-top font-normal text-fg">
              {group.name}
            </th>
            <td class="px-4 py-3 align-top text-muted">
              {group.items.join(", ")}
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
